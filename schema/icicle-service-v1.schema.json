{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/icicle-ai/cicd-templates/schema/icicle-service-v1.schema.json",
  "title": "ICICLE service configuration, schema version 1",
  "type": "object",
  "required": [
    "schema-version", "service-name", "service-version", "project-name",
    "service-type", "pod-name", "runtime-type", "runtime-version"
  ],
  "properties": {
    "schema-version": {"type": "integer", "const": 1},
    "service-name": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$"},
    "service-version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project-name": {"type": "string", "pattern": "\\S"},
    "service-type": {"type": "string", "enum": ["ai", "ci", "domain"]},
    "pod-name": {"type": "string", "pattern": "^[a-z][a-z0-9]{3,63}$"},
    "runtime-type": {"type": "string", "enum": ["python", "node-backend", "node-frontend"]},
    "runtime-version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "build-apt-packages": {"$ref": "#/$defs/packages", "default": []},
    "runtime-apt-packages": {"$ref": "#/$defs/packages", "default": []},
    "health-url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "rollout-timeout": {"type": "integer", "minimum": 30, "maximum": 1800, "default": 300},
    "include-dev-dependencies": {"type": "boolean", "default": true}
  },
  "additionalProperties": true,
  "$defs": {
    "packages": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "A Debian package name, optionally with :architecture and =exact-version.",
        "pattern": "^[a-z0-9][a-z0-9+.-]+(?::[a-z0-9][a-z0-9-]*)?(?:=[0-9][A-Za-z0-9.+:~\\-]*)?$"
      }
    }
  }
}
