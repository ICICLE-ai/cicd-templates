{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/icicle-ai/cicd-templates/schema/icicle-service-v3.schema.json",
  "title": "ICICLE service configuration, schema version 3",
  "description": "Uses service-name as the image repository name and deployment pod name. Do not include pod-name in the service YAML.",
  "type": "object",
  "required": [
    "schema-version", "service-name", "service-version", "project-name",
    "service-type", "runtime-type", "runtime-version"
  ],
  "properties": {
    "schema-version": {"type": "integer", "const": 3},
    "service-name": {"type": "string", "pattern": "^[a-z][a-z0-9]{3,63}$", "not": {"enum": ["catalog", "snapshots", "volumes", "admin", "catalogs", "snapshot", "volume", "image", "images", "template", "templates", "stack", "stacks", "nodes", "metrics", "secrets"]}, "description": "Image repository name and pod name: 4-64 lowercase letters or digits, starting with a letter; reserved Tapis pod identifiers are not allowed."},
    "service-version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project-name": {"type": "string", "pattern": "\\S"},
    "service-type": {"type": "string", "enum": ["ai", "ci", "domain"]},
    "pod-name": false,
    "runtime-type": {"type": "string", "enum": ["python", "node-backend", "node-frontend"]},
    "runtime-version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$", "description": "MAJOR.MINOR resolves the newest available patch in that minor line; MAJOR.MINOR.PATCH selects an exact release."},
    "build-apt-packages": {"$ref": "#/$defs/packages", "default": []},
    "runtime-apt-packages": {"$ref": "#/$defs/packages", "default": []},
    "health-url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "rollout-timeout": {"type": "integer", "minimum": 30, "maximum": 1800, "default": 300},
    "include-dev-dependencies": {"type": "boolean", "default": true},
    "npm-install-mode": {"type": "string", "enum": ["auto", "full"], "default": "auto", "description": "Node only. auto caches manifest-only installs when safe; full always installs after copying source."}
  },
  "additionalProperties": true,
  "$defs": {
    "packages": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "A Debian package name, optionally with :architecture and =exact-version.",
        "pattern": "^[a-z0-9][a-z0-9+.-]+(?::[a-z0-9][a-z0-9-]*)?(?:=[0-9][A-Za-z0-9.+:~\\-]*)?$"
      }
    }
  }
}
