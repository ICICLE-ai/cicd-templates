# ──────────────────────────────────────────────────────────────────────────
# ICICLE .dockerignore template (Node)
# Keeps build context small and prevents secrets / junk from entering images.
# ──────────────────────────────────────────────────────────────────────────

# Version control
.git/
.gitignore
.gitattributes

# Node artifacts — node_modules is ALWAYS reinstalled in the container.
# Copying a host node_modules in breaks native modules and bloats the context.
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/
.npm/
.yarn/
*.tsbuildinfo

# Build output — regenerated by `npm run build` inside the image.
# If your service commits prebuilt output instead of building in CI,
# remove the relevant line here.
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
coverage/
.nyc_output/

# Environments & secrets — NEVER bake these into images
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
.secrets/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# CI / local tooling output
.github/
*.log
logs/

# Docker itself — don't recurse
Dockerfile
.dockerignore

# Documentation (usually not needed in image)
docs/
*.md
!README.md

# Data / notebooks (opt-in if your service needs them)
*.ipynb
.ipynb_checkpoints/
data/
*.csv
*.parquet
*.h5
*.hdf5
