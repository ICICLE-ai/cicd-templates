# Enabled only when BACKEND_URL is set. Match /api and /api/... but not /apiary.
location ~ ^/api(?:/|$) {
    # No URI or trailing slash here: preserve the complete path and query.
    # The startup script substitutes only BACKEND_URL, leaving nginx variables.
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # Keep upstream redirects rewritten by proxy_redirect relative, avoiding
    # an internal http://frontend:8000 URL behind Tapis's HTTPS ingress.
    absolute_redirect off;

    # Route HTTPS/virtual-host upstreams using their own host, while telling
    # the application which frontend host and client originated the request.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $icicle_forwarded_proto;

    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 5;
}
